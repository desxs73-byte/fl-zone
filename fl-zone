        title: 'MIDI',
        desc: 'MIDI-паттерны и мелодии',
        items: [
          { name: 'Trap Melodies 50', author: 'MIDI Factory', price: 'free', icon: '🎼' },
          { name: 'Jazz Progressions', author: 'Jazz Cat', price: 'paid', icon: '🎷' },
        ]
      },
      banks: {
        title: 'Банки',
        desc: 'Sound banks для синтезаторов',
        items: [
          { name: 'Serum Presets Dark', author: 'Preset Lab', price: 'paid', icon: '💾' },
          { name: 'Massive X Bundle', author: 'NI Community', price: 'free', icon: '🎛️' },
        ]
      },
      presets: {
        title: 'Пресеты',
        desc: 'Готовые пресеты для сведения и вокала',
        items: [
          { name: 'Vocal Chain Pro', author: 'Mix Master', price: 'paid', icon: '🎙️' },
          { name: 'Mastering Preset', author: 'Loudness', price: 'free', icon: '🔊' },
        ]
      },
      projects: {
        title: 'Проекты',
        desc: 'Готовые проекты FL Studio / Ableton',
        items: [
          { name: 'Trap Template 2025', author: 'Beat School', price: 'free', icon: '📁' },
          { name: 'Drill Project Full', author: 'UK Producer', price: 'paid', icon: '📂' },
        ]
      },
      beats: {
        title: 'Биты пользователей',
        desc: 'Биты, загруженные сообществом',
        items: [] // will be filled from localStorage
      }
    };

    // Load community beats from all users
    function loadCommunityBeats() {
      const users = JSON.parse(localStorage.getItem('flzone_users') || '[]');
      const beats = [];
      users.forEach(u => {
        (u.uploads || []).forEach(up => {
          if (up.type === 'beat' || up.type === 'drumkit' || up.type === 'sample') {
            beats.push({
              name: up.name,
              author: u.nickname,
              price: up.price === 'free' ? 'free' : 'paid',
              icon: up.type === 'beat' ? '🎧' : up.type === 'drumkit' ? '🥁' : '🎵'
            });
          }
        });
      });
      content.beats.items = beats.length ? beats : [
        { name: 'Пока нет загрузок', author: 'Загрузи первый!', price: 'free', icon: '📭' }
      ];
    }

    function renderSection(key) {
      const section = content[key];
      if (!section) return;

      if (key === 'beats') loadCommunityBeats();

      document.getElementById('sectionTitle').textContent = section.title;
      document.getElementById('sectionDesc').textContent = section.desc;

      const grid = document.getElementById('cardsGrid');
      grid.innerHTML = section.items.map(item => `
        <div class="card">
          <div class="card-preview">${item.icon}</div>
          <div class="card-body">
            <div class="card-title">${item.name}</div>
            <div class="card-meta">
              <span>${item.author}</span>
              <span class="badge ${item.price === 'free' ? 'badge-free' : 'badge-paid'}">
                ${item.price === 'free' ? 'Бесплатно' : 'Платно'}
              </span>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Nav click
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
        renderSection(item.dataset.section);
      });
    });

    // Initial render
    renderSection('plugins');
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FL Zone — Вход</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-logo">
        <h1>FL Zone</h1>
        <p>Всё для битмейкера в одном месте</p>
      </div>

      <div class="auth-tabs">
        <button class="auth-tab active" data-tab="login">Вход</button>
        <button class="auth-tab" data-tab="register">Регистрация</button>
      </div>

      <!-- Login Form -->
      <form class="auth-form active" id="loginForm">
        <div class="form-group">
          <label>Email или логин</label>
          <input type="text" id="loginEmail" placeholder="you@example.com" required>
        </div>
        <div class="form-group">
          <label>Пароль</label>
          <input type="password" id="loginPassword" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Войти</button>
      </form>

      <!-- Register Form -->
      <form class="auth-form" id="registerForm">
        <div class="form-group">
          <label>Никнейм</label>
          <input type="text" id="regNickname" placeholder="Твой ник" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="regEmail" placeholder="you@example.com" required>
        </div>
        <div class="form-group">
          <label>Пароль</label>
          <input type="password" id="regPassword" placeholder="Минимум 6 символов" required minlength="6">
        </div>
        <div class="form-group">
          <label>Повтори пароль</label>
          <input type="password" id="regPassword2" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Создать аккаунт</button>
      </form>

      <div class="auth-footer">
        Продолжая, ты соглашаешься с правилами FL Zone
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    // Tab switching
    document.querySelectorAll('.auth-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.auth-form').forEach(f => f.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(tab.dataset.tab === 'login' ? 'loginForm' : 'registerForm').classList.add('active');
      });
    });

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 3000);
    }

    // Check if already logged in
    if (localStorage.getItem('flzone_user')) {
      window.location.href = 'dashboard.html';
    }

    // Login
    document.getElementById('loginForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const email = document.getElementById('loginEmail').value.trim();
      const password = document.getElementById('loginPassword').value;

      const users = JSON.parse(localStorage.getItem('flzone_users') || '[]');
      const user = users.find(u => (u.email === email || u.nickname === email) && u.password === password);

      if (user) {
        localStorage.setItem('flzone_user', JSON.stringify(user));
        window.location.href = 'dashboard.html';
      } else {
        showToast('Неверный логин или пароль');
      }
    });

    // Register
    document.getElementById('registerForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const nickname = document.getElementById('regNickname').value.trim();
      const email = document.getElementById('regEmail').value.trim();
      const password = document.getElementById('regPassword').value;
      const password2 = document.getElementById('regPassword2').value;

      if (password !== password2) {
        showToast('Пароли не совпадают');
        return;
      }

      const users = JSON.parse(localStorage.getItem('flzone_users') || '[]');
      if (users.find(u => u.email === email)) {
        showToast('Email уже зарегистрирован');
        return;
      }
      if (users.find(u => u.nickname === nickname)) {
        showToast('Никнейм уже занят');
        return;
      }

      const newUser = {
        id: Date.now(),
        nickname,
        email,
        password,
        createdAt: new Date().toISOString(),
        uploads: []
      };

      users.push(newUser);
      localStorage.setItem('flzone_users', JSON.stringify(users));
      localStorage.setItem('flzone_user', JSON.stringify(newUser));
      showToast('Аккаунт создан!');
      setTimeout(() => window.location.href = 'dashboard.html', 800);
    });
  </script>
</body>
</html>
